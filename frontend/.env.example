# Скопируй в .env.local (в git не попадает).

# Адрес API. Пусто — фронт работает на мок-данных из src/mocks/.
# В Docker по умолчанию /api/v1 (прокси nginx на бэкенд), см. Dockerfile.
VITE_API_URL=
# VITE_API_URL=http://localhost:8080/api/v1

# Гибридный режим: методы, которые бэкенд ещё не отдаёт (501, недоступен), берутся из моков.
VITE_MOCK_FALLBACK=true

# Стиль подложки карты MapLibre. Пусто — тёмный фон без подложки (работает без интернета).
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
