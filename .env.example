# Пример настроек. Скопируй в .env и заполни своими значениями. Сам .env в git не кладём.

# База данных (тип выбирает Артём: PostgreSQL / ClickHouse)
DB_HOST=db
DB_PORT=5432
DB_NAME=tram
DB_USER=tram
DB_PASSWORD=change_me

# Бэкенд
API_PORT=8080

# Фронтенд
VITE_API_URL=http://localhost:8080/api/v1

# Бизнес-параметры (раздел 6 в CLAUDE.md)
PASSENGERS_PER_TRAM_NORM=150
TRAM_PREP_MINUTES=40

# Авторизация API (раздел 13.2 в CLAUDE.md — базовая авторизация желательна).
# Свои значения — не коммитить, для жюри отдаются отдельным файлом.
AUTH_INGEST_TOKEN=change_me_ingest
AUTH_DISPATCHER_TOKEN=change_me_dispatcher

# Размер пула соединений к БД (подобран нагрузочным тестом, см. README раздел «Производительность»)
DB_POOL_SIZE=30

# Время
TZ=Europe/Moscow
